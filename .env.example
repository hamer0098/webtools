# 管理员账号（前台开放，仅 /admin 需要登录）
ADMIN_USERNAME=admin

# 用 argon2 生成的哈希。生成方式：
#   node -e "require('argon2').hash('your-password').then(console.log)"
#
# 重要：argon2 哈希含多个 $ 字符，会被变量插值破坏，必须转义。
# 但开发和 Docker 生产的转义方式不同（读 env 的链路不一样）：
#
#   .env.local（npm run dev）：Next.js dotenv 用反斜杠转义，每个 $ 写成 \$
#     ADMIN_PASSWORD_HASH=\$argon2id\$v=19\$m=65536,t=3,p=4\$saltbase64\$hashbase64
#
#   .env.production（docker compose env_file）：Docker Compose 用双美元转义，每个 $ 写成 $$
#     ADMIN_PASSWORD_HASH=$$argon2id$$v=19$$m=65536,t=3,p=4$$saltbase64$$hashbase64
#     自检：docker compose -f docker-compose.prod.yml config 2>&1 | grep -i 'not set'（无输出才对）
ADMIN_PASSWORD_HASH=

# iron-session 加密密钥，至少 32 字符的随机串
# 生成方式： openssl rand -base64 48
SESSION_SECRET=

# SQLite 数据库路径（默认 ./data/webtools.db）
DATABASE_PATH=./data/webtools.db

# ---- 临时邮箱 (tempmail) ----
# 没配置时前端显示"未配置"提示，整个工具不可用，其他工具不受影响。
# 还需要在 Cloudflare 上为该域名启用 Email Routing 并部署 cf-worker/tempmail-worker.js。
# 详见 cf-worker/README.md
TEMPMAIL_DOMAIN=

# CF Email Worker 调 /api/tempmail/inbound 用的共享密钥。
# 生成方式： openssl rand -hex 32
# Worker 必须在 X-Webhook-Secret header 带相同值，否则 401。
TEMPMAIL_WEBHOOK_SECRET=

# ---- 中文转换的翻译 provider ----
# 候选：mock（默认，占位文本）、deeplx（DeepL 第三方免费 API）
# 接其它 API（百度/有道/官方 DeepL）：在 lib/translate.ts 的 PROVIDERS 注册新实现
TRANSLATE_PROVIDER=mock

# 当 TRANSLATE_PROVIDER=deeplx 时生效。
# 公开镜像（api.deeplx.org / deeplx.vercel.app 等）现在普遍被滥用/封禁/troll，不稳定。
# 推荐路径：
#   A. 去 https://deeplx.missuo.ru 用 GitHub 登录拿专属 endpoint（3 年以上账号 50 万字符/天，
#      新账号 1 万/天）—— 5 分钟搞定。
#   B. 自建 CF Workers，参考 https://github.com/xixu-me/DeepLX —— 完全免费 + 全球边缘加速。
# 多个 URL 用英文逗号分隔，主挂了自动顺次降级到备用 URL。
TRANSLATE_DEEPLX_URL=
